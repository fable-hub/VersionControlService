<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>VersionControlService.Abstractions</PackageId>
    <Description>Provider-neutral version control contracts: one interface that every provider serves.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Identifiers.fs" />
    <Compile Include="Paths.fs" />
    <Compile Include="DiffFailureDetail.fs" />
    <Compile Include="Operations.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Repository.fs" />
    <Compile Include="CallResult.fs" />
    <Compile Include="Refs.fs" />
    <Compile Include="Synchronization.fs" />
    <Compile Include="Conflicts.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="TextDiff.fs" />
    <Compile Include="ObjectMaterialization.fs" />
    <Compile Include="StoragePolicy.fs" />
    <Compile Include="StorageMaintenance.fs" />
    <Compile Include="RepositoryBrowser.fs" />
    <Compile Include="History.fs" />
    <Compile Include="ProviderFunctions.fs" />
    <Compile Include="VersionControl.fs" />
    <Compile Include="Subscribe.fs" />
    <Compile Include="ProviderResolution.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; *.fs" PackagePath="fable\" />
  </ItemGroup>
</Project>
